{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "orchestrator",
  "model": "qwencloud/qwen3.8-max",
  "small_model": "zai-coding-plan/glm-5.3-flash",
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
    },
    "memory-graph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        // Host-side project config: use the host memory store (same file as
        // the global ~/.config/opencode/opencode.jsonc). The container copy
        // (image/.opencode/opencode.json) keeps /app/.memory/memory.jsonl
        // (persisted by the `opencode-memory` compose volume) — /app does
        // not exist on the host. {env:HOME} keeps this portable across
        // contributors instead of hardcoding one developer's home dir.
        "MEMORY_FILE_PATH": "{env:HOME}/.local/share/opencode/memory.jsonl",
      },
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}",
      },
      "enabled": true,
    },
  },
  // // Allow all tools (built-ins + all MCP servers, incl. the remote
  // // web-reader/web-search-prime/zread/exa research tools) without prompting.
  // // Matches the production source of truth (image/.opencode/opencode.json).
  // // MCP tool keys are "<server>_<tool>" (e.g. web-reader_webReader); the bare
  // // "allow" string covers them all without enumeration.
  // "permission": "allow",
  "provider": {
    // Z.AI Coding Plan — built-in provider (creds resolved from auth.json;
    // env fallback ZAI_CODING_PLAN_OPEN_AI_API_KEY / Z_AI_API_KEY).
    "zai-coding-plan": {
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
        },
        "glm-5.3": {
          "name": "GLM 5.3",
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
        },
        "glm-4.7": {
          "name": "GLM 4.7",
        },
        "glm-4.5-air": {
          "name": "GLM 4.5 Air",
        },
      },
    },
    // Cline Pass — Cline's low-cost subscription ($9.99/month) giving
    // reliable access to open coding models with 2-5x API rate limits.
    // OpenAI-compatible endpoint; API key resolved from env: CLINE_API_KEY.
    "cline-pass": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline Pass",
      "options": {
        "apiKey": "{env:CLINE_API_KEY}",
        "baseURL": "https://api.cline.bot/api/v1",
      },
      "models": {
        "cline-pass/glm-5.2": {
          "name": "GLM 5.2",
        },
        "cline-pass/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
        },
        "cline-pass/kimi-k2.6": {
          "name": "Kimi K2.6",
        },
        "cline-pass/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
        },
        "cline-pass/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
        },
        "cline-pass/mimo-v2.5": {
          "name": "MiMo V2.5",
        },
        "cline-pass/mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
        },
        "cline-pass/minimax-m3": {
          "name": "MiniMax M3",
        },
        "cline-pass/qwen3.7-max": {
          "name": "Qwen 3.7 Max",
        },
        "cline-pass/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus",
        },
      },
    },
    "qwencloud": {
      "npm": "@ai-sdk/anthropic",
      "name": "QwenCloud",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:QWENCLOUD_TOKEN_PLAN_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "options": {
            "thinking": {
              "type": "enabled", // always enabled by default/cannot be disabled
              "budgetTokens": 99072
            },
            "temperature": 0.6, // >= 0.6
            "reasoning": true,
          },
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "limit": {
            "context": 983616,
            "output": 65536
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16384,
            },
          },
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            }
          }
        }
      }
    }
  }
}