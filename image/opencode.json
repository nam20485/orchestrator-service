{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2.6:free": {},
        "nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "nvidia/nemotron-3-super-120b-a12b:free": {}
      }
    },
    "bailian-payg": {
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "baseURL": "https://dashscope-intl.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:MS_DS_API_KEY}"
      },
      "models": {
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "deepseek-v3.2": {
          "name": "DeepSeek V3.2"
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    },
    "zai-coding-plan": {
      "models": {
        "glm-5": {
          "name": "GLM-5",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.7-flash": {
          "name": "GLM-4.7-Flash",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.7-flashx": {
          "name": "GLM-4.7-FlashX",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.5": {
          "name": "GLM-4.5",
          "limit": {
            "context": 131072,
            "output": 96000
          }
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "model": "bailian-payg/qwen3.6-plus",
  "small_model": "bailian-payg/qwen3.6-flash",
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "mcp_tool": {
      "sequential-thinking:sequentialthinking": "allow",
      "memory-graph:create_entities": "allow",
      "memory-graph:create_relations": "allow",
      "memory-graph:add_observations": "allow",
      "memory-graph:delete_entities": "allow",
      "memory-graph:delete_observations": "allow",
      "memory-graph:delete_relations": "allow",
      "memory-graph:read_graph": "allow",
      "memory-graph:search_nodes": "allow",
      "memory-graph:open_nodes": "allow"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory-graph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/app/.memory/memory.jsonl"
      }
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "notion-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_MCP_CONNECTIONS_API_KEY}"
      }
    }
  }
}