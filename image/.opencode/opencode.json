{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {}
      }
    },
    "bailian-payg": {
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "baseURL": "https://dashscope-intl.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:MS_DS_API_KEY}"
      },
      "models": {
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    },
    "zai-coding-plan": {
      "models": {
        "glm-5": {
          "name": "GLM-5",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-4.7-flash": {
          "name": "GLM-4.7-Flash",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "model": "bailian-payg/qwen3.6-plus",
  "small_model": "bailian-payg/qwen3.6-flash",
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "mcp_tool": {
      "sequential-thinking:sequentialthinking": "allow",
      "memory-graph:create_entities": "allow",
      "memory-graph:create_relations": "allow",
      "memory-graph:add_observations": "allow",
      "memory-graph:delete_entities": "allow",
      "memory-graph:delete_observations": "allow",
      "memory-graph:delete_relations": "allow",
      "memory-graph:read_graph": "allow",
      "memory-graph:search_nodes": "allow",
      "memory-graph:open_nodes": "allow"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory-graph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/app/.memory/memory.jsonl"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "{env:ZAI_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "{env:ZAI_API_KEY}"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "{env:ZAI_API_KEY}"
      }
    }
  }
}
