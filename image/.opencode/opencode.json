{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "orchestrator",
  "model": "qwencloud/qwen3.8-max",
  "small_model": "zai-coding-plan/glm-5.3-flash",
  "agent": {
    // Subagent model+variant overrides. The orchestrator uses the session
    // default model (line-8: qwencloud/qwen3.8-max) and
    // receives variant from the dispatch CLI (--variant high). Subagents are
    // pinned to zai-coding-plan/glm-5.3-flash at "high" variant.
    "developer": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "code-reviewer": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "debugger": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "documentation-expert": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "github-expert": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "odbplusplus-expert": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "planner": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "qa-test-engineer": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "researcher": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "security-expert": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    },
    "agent-instructions-expert": {
      "model": "zai-coding-plan/glm-5.3-flash",
      "variant": "high"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory-graph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/app/.memory/memory.jsonl",
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "{env:ZAI_CODING_API_KEY}",
      },
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      },
      "enabled": true
    },
  },
  "permission": "allow",
  "provider": {
    // Z.AI Coding Plan — built-in provider (creds resolved from auth.json;
    // env fallback ZAI_CODING_PLAN_OPEN_AI_API_KEY / Z_AI_API_KEY).
    "zai-coding-plan": {
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "glm-4.7": {
          "name": "GLM 4.7",
        },
        "glm-4.5-air": {
          "name": "GLM 4.5 Air",
        },
        "glm-5": {
          "name": "GLM 5",
        },
        "glm-5.1": {
          "name": "GLM 5.1",
        },
      },
    },
    // Google AI Studio — built-in provider, reads GEMINI_API_KEY from env.
    "google": {
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
        },
      },
    },
    // NVIDIA NIM — built-in provider (build.nvidia.com). Credentials and the
    // NIM base URL are resolved from env: NVIDIA_NIM_API_KEY and
    // NVIDIA_NIM_BASE_URL (defaults to https://integrate.api.nvidia.com/v1).
    // The built-in "nvidia" provider normally reads NVIDIA_API_KEY, so the
    // apiKey option below overrides it to use the NIM key.
    "nvidia": {
      "options": {
        "apiKey": "{env:NVIDIA_NIM_API_KEY}",
        "baseURL": "{env:NVIDIA_NIM_BASE_URL}",
      },
      "models": {
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3",
          "tool_call": true,
        },
      },
    },
    // ClinePass — OpenAI-compatible endpoint for ClinePass subscription models.
    // API key resolved from env: CLINE_API_KEY (create one at
    // https://app.cline.bot → Settings > API Keys).
    // Full model list: https://docs.cline.bot/getting-started/clinepass#models
    "cline-pass": {
      "npm": "@ai-sdk/openai",
      "name": "ClinePass",
      "options": {
        "apiKey": "{env:CLINE_API_KEY}",
        "baseURL": "https://api.cline.bot/api/v1",
        "compatibility": "compatible",
      },
      "models": {
        "cline-pass/qwen3.7-max": {
          "name": "Qwen 3.7 Max",
          "tool_call": true,
        },
      },
    },
    // QwenCloud Token Plan — OpenAI-compatible endpoint for Alibaba Cloud
    // token-plan subscription models. API key resolved from env:
    // QWENCLOUD_TOKEN_PLAN_API_KEY.
    "qwencloud": {
      "npm": "@ai-sdk/anthropic",
      "name": "QwenCloud",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:QWENCLOUD_TOKEN_PLAN_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "options": {
            "thinking": {
              "type": "enabled", // always enabled by default/cannot be disabled
              "budgetTokens": 99072,
              "reasoning_effort": "xhigh" // xhigh, medium, low (defaults to xhigh)
            },
            "temperature": 0.6, // >= 0.6
            "reasoning": true,
          },
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "limit": {
            "context": 983616,
            "output": 65536
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16384
            }
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            }
          }
        }
      }
    }
  }
}