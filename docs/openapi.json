    "/api/dashboard/run-events": {
      "get": {
        "description": "Typed tool-stream events for a dispatch run (default: newest).\n\nParses the run's captured ``.stderr`` glyphs into a readable event list\nfor the live ``/dashboard/events`` feed. Returns the stem list so the\npage can switch runs. All blocking work (run discovery, file read, glyph\nparse) runs off the event loop; results are cached by content mtime/size\nso the 5s client poll is cheap even on multi-MB transcripts.",
        "operationId": "run_events_api_dashboard_run_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "stem",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stem"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Events Api Dashboard Run Events Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Events",
        "tags": [
          "dashboard"
        ]
      }
    },
