{
  "name": "orchestrator-service",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && ~/.local/bin/uv sync --group dev && pwsh -NoProfile -Command \"Install-Module Pester -MinimumVersion 5.0.0 -Scope CurrentUser -Force\" && ~/.local/bin/uv run pre-commit install",
  "forwardPorts": [80, 4099, 8080],
  "portsAttributes": {
    "80": { "label": "webhook-proxy (Caddy)" },
    "4099": { "label": "orchestratorservice (opencode serve)" },
    "8080": { "label": "webhook-receiver (FastAPI)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.powershell",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
